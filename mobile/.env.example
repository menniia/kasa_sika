# Optional. Base URL of the Kasa Sika API (backend/src/KasaSika.Api, default port 5126).
# Leave unset to auto-detect: web uses http://localhost:5126; a phone running Expo Go uses the
# same LAN IP as the Expo dev server, port 5126.
# Never put MTN or Khaya keys here: EXPO_PUBLIC_* values are bundled into the app.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:5126
