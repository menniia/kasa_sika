{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "KasaSika": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },

  "Security": {
    "JwtSigningKey": "",
    "FieldEncryptionKey": "",
    "FingerprintKey": ""
  },

  "Payments": {
    "Provider": "Mock",
    "CallbackBaseUrl": null
  },

  "Mtn": {
    "BaseUrl": "https://sandbox.momodeveloper.mtn.com",
    "TargetEnvironment": "sandbox",
    "Currency": "EUR",
    "SubscriptionKey": "",
    "ApiUser": "",
    "ApiKey": ""
  },

  "Khaya": {
    "BaseUrl": "https://developer-api.khaya.ai",
    "AsrPath": "/asr/v3/transcribe",
    "TtsPath": "/tts/v2/synthesize",
    "TranslatePath": "/v2/translate",
    "Voice": "female",
    "AudioFormat": "mp3",
    "CacheDirectory": ".cache/tts",
    "SubscriptionKey": "",
    "SecondarySubscriptionKey": ""
  },

  "Languages": {
    "Default": "en",
    "Supported": [
      { "Code": "en", "EnglishName": "English", "NativeName": "English", "Enabled": true, "ProviderCode": "eng", "DeviceLocale": "en-GH", "ServerTts": false, "ServerAsr": true },
      { "Code": "tw", "EnglishName": "Twi", "NativeName": "Twi", "Enabled": true, "ProviderCode": "twi", "DeviceLocale": null, "ServerTts": true, "ServerAsr": true },
      { "Code": "ee", "EnglishName": "Ewe", "NativeName": "Eʋegbe", "Enabled": false, "ProviderCode": "ewe", "DeviceLocale": null, "ServerTts": true, "ServerAsr": true },
      { "Code": "gaa", "EnglishName": "Ga", "NativeName": "Gã", "Enabled": false, "ProviderCode": "gaa", "DeviceLocale": null, "ServerTts": true, "ServerAsr": true },
      { "Code": "dag", "EnglishName": "Dagbani", "NativeName": "Dagbanli", "Enabled": false, "ProviderCode": "dag", "DeviceLocale": null, "ServerTts": true, "ServerAsr": true }
    ]
  },

  "Authentication": {
    "MaxFailedAttempts": 3,
    "LockoutMinutes": 15,
    "SessionHours": 8,
    "AllowSelfRegistration": false,
    "StepUpMethods": [ "Passcode", "DeviceBiometric" ],
    "ChallengeSeconds": 300
  },

  "Limits": {
    "MaxTransactionMinor": 100000,
    "MaxDailyMinor": 500000,
    "TransactionTtlMinutes": 10
  },

  "Reconciliation": {
    "Enabled": true,
    "IntervalSeconds": 15,
    "NotFoundGraceMinutes": 10,
    "StaleSubmittingMinutes": 2,
    "EscalateUnknownAfterMinutes": 30
  },

  "Demo": {
    "Enabled": false
  }
}
